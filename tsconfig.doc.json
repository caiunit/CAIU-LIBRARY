{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es5",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2020", "dom"],
    "paths": {
      "library": [
        /* "dist/library" */
        "projects/library/src/public_api"
      ],
      "library/*": ["dist/library/*"],
      "grid": [
        /* "dist/grid" */
        "projects/grid/src/public_api"
      ],
      "grid/*": ["dist/grid/*"]
    }
  }
}
